{
  "name": "pokemonsaveeditor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A browser-based, client-side-only Pokémon save file editor.",
  "author": "Pokémon Save Editor contributors",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:standalone": "tsc -b && cross-env STANDALONE=true vite build && node scripts/inline-favicon.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:gen1": "tsx scripts/gen1-roundtrip-test.mjs",
    "test:gen2": "tsx scripts/gen2-roundtrip-test.mjs",
    "test:gen3": "tsx scripts/gen3-roundtrip-test.mjs",
    "test:gen4": "tsx scripts/gen4-roundtrip-test.mjs",
    "test:events": "tsx scripts/events-roundtrip-test.mjs",
    "electron:dev": "npm run build:standalone && electron .",
    "dist:mac": "npm run build:standalone && electron-builder --mac",
    "dist:win": "npm run build:standalone && electron-builder --win",
    "dist:linux": "npm run build:standalone && electron-builder --linux"
  },
  "build": {
    "appId": "com.pokemonsaveeditor.app",
    "productName": "Pokémon Save Editor",
    "publish": null,
    "files": [
      "electron/**/*",
      "dist-standalone/**/*"
    ],
    "directories": {
      "output": "dist-electron"
    },
    "mac": {
      "category": "public.app-category.utilities",
      "target": ["dmg"]
    },
    "win": {
      "target": ["nsis"]
    },
    "linux": {
      "target": ["AppImage"],
      "category": "Utility"
    }
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "cross-env": "^10.1.0",
    "electron": "^44.1.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.75.0",
    "playwright": "^1.62.1",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
